#!/usr/bin/env sh
# Never push directly to main: use a branch and a draft PR.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing directly to main is not allowed. Push a branch and open a draft PR." >&2
    exit 1
  fi
done

# Branch-wide checks. CI re-enforces all of these (hooks can be bypassed client-side).
npm run lint
npm run typecheck
npm run test:coverage
RELEASE_TRIGGER_PATHS=pyproject.toml,adapters.py,browser_crawl.py,build_dashboard.py,classify.py,common.py,digest.py,discover.py,regions.py,run.py,send_alert.py,send_email.py,survey.py,survey2.py BASE_REF=origin/main node scripts/check-release.mjs
