{
  "name": "misra",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Daily batch pipeline that crawls career pages, keeps history in SQLite, and emails a digest.",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint:py && npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:md",
    "lint:py": ".venv/bin/python -m ruff check . && .venv/bin/python -m ruff format --check .",
    "lint:js": "eslint --max-warnings=0 .",
    "lint:css": "stylelint --max-warnings=0 --allow-empty-input \"**/*.css\"",
    "lint:html": "node scripts/lint-html.mjs",
    "lint:md": "markdownlint-cli2",
    "typecheck": ".venv/bin/python -m mypy",
    "test": "vitest run && .venv/bin/python -m pytest",
    "test:coverage": "vitest run && .venv/bin/python -m pytest --cov --cov-report=term-missing",
    "check:generated": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "axe-core": "4.14.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.1",
    "semver": "7.8.6",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
